# ARCoS Package Manager - configuration.
#
# Copy to .env and fill in. .env is gitignored and must never be committed.
# Nothing here names a specific machine by default; the values are yours.

# ---------------------------------------------------------------------------
# Where git commands run
# ---------------------------------------------------------------------------
# auto   send only the private repositories (below) over the SSH bridge, and run
#        everything else locally. Right for a laptop without repository access.
# local  run every git command on this machine. Right where this host already
#        has access to the private repositories.
# ssh    run every git command on the configured host.
APM_GIT_BACKEND=auto

# Which repositories need the bridge. Comma-separated regular expressions
# matched against the repository URL. Overrides config/settings.yaml.
# APM_PRIVATE_REPOSITORY_PATTERNS=github\.com[:/]+myorg/

# ---------------------------------------------------------------------------
# SSH bridge (only needed when APM_GIT_BACKEND is auto or ssh)
# ---------------------------------------------------------------------------
# May be an ssh_config alias, in which case user, port, key and ProxyJump can
# all live in ~/.ssh/config and nothing else below is needed. See
# docs/deployment.md.
APM_SSH_HOST=
APM_SSH_USER=
# APM_SSH_PORT=22
# APM_SSH_IDENTITY_FILE=~/.ssh/id_ed25519
# Jump through a bastion: user@bastion[:port]
# APM_SSH_PROXY_JUMP=
# APM_SSH_KNOWN_HOSTS=~/.ssh/known_hosts
# accept-new trusts a host the first time and pins it after. Use 'yes' once the
# host key is in known_hosts.
APM_SSH_STRICT_HOST_KEY_CHECKING=accept-new
# APM_SSH_OPTIONS=ServerAliveInterval=30,ServerAliveCountMax=3
APM_SSH_CONNECT_TIMEOUT=30
# Last resort, for hosts that permit nothing better. Prefer a key or an agent.
# Anything set here is a secret: never commit it.
APM_SSH_PASSWORD=

# ---------------------------------------------------------------------------
# GitHub (needed to open pull requests; reading works without it over SSH)
# ---------------------------------------------------------------------------
# Used only by the REST API calls that look up and open pull requests
# (apm publish-upstream-md --apply, and the dashboard's "Create pull request").
# Git itself - fetch and push - goes over the SSH bridge with the key on the
# bridge host, never with this token.
#
# Permissions: a fine-grained token owned by the organisation, limited to the
# package repositories, with "Pull requests: Read and write" and "Metadata:
# Read". Contents: write is NOT needed, because pushes use SSH. A classic token
# with `repo` scope also works. If the organisation enforces SAML SSO, the token
# must be SSO-authorised for it; the publisher's pre-flight says so if not.
#
# LEAVE THIS EMPTY for the mapping, workbook, debian/upstream.md generation and
# publish dry runs - none of them needs a token. Without one the application is
# read-only and the dashboard says so. Never paste the value into chat or logs.
APM_GITHUB_TOKEN=
APM_GITHUB_API_URL=https://api.github.com

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
APM_CACHE_DIR=~/.cache/arcos-package-manager
# Where clones and cherry-pick worktrees are made. On the host git runs on, so
# with the ssh backend this is a path on THAT host. Defaults to a temp dir.
# APM_WORKSPACE_DIR=/var/tmp/arcos-package-manager
# Where `discover` writes the generated package catalogue. Unset: the committed
# config/packages.yaml. docker-compose sets /app/out/packages.yaml, because
# config/ is mounted read-only there.
# APM_PACKAGES_FILE=
APM_CACHE_TTL=86400

# ---------------------------------------------------------------------------
# Timeouts (seconds) and commit identity
# ---------------------------------------------------------------------------
APM_HTTP_TIMEOUT=120
APM_GIT_TIMEOUT=60
APM_GIT_LONG_TIMEOUT=1800
# Author and committer of the debian/upstream.md commits. Set to the person
# accountable for the pull requests, e.g. APM_COMMITTER_NAME=Jane Doe and
# APM_COMMITTER_EMAIL=jane.doe@arrcus.com.
APM_COMMITTER_NAME=ARCoS Package Manager
APM_COMMITTER_EMAIL=arcos-package-manager@localhost

# ---------------------------------------------------------------------------
# Frontend (Vite reads this at build time)
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=/api
