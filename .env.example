# ARCoS Package Manager - configuration.
#
#   cp .env.example .env     then edit. .env is gitignored: never commit it.
#
# Nothing here names a real machine or person. Paths are examples - use your
# own. The values that matter for a first `docker compose up` are marked (*).

# ---------------------------------------------------------------------------
# Docker deployment (the standard way to run it)
# ---------------------------------------------------------------------------
# (*) The container user. Set both to the owner of the host directories mounted
# below and of the SSH key - on the host run:  id -u   and   id -g
# Changing them needs a rebuild (docker compose up -d --build).
APM_UID=1000
APM_GID=1000

# Browsers reach the dashboard at http://<server-ip>:APM_PORT/. The container
# always listens on 8080 inside. APM_BIND_ADDRESS=127.0.0.1 keeps it local.
APM_PORT=8080
APM_BIND_ADDRESS=0.0.0.0

# This deployment's own token for every action that writes: pushing a branch,
# a cherry-pick that pushes, approving a content base.
# The dashboard asks for it the first time one is attempted and keeps it for
# that browser tab only. Left empty, anyone who can reach APM_PORT can push with
# this server's SSH key - acceptable only on a network you trust. Generate one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
APM_API_TOKEN=

# Whether THIS machine may push branches (1 to allow). Set it only on the one
# machine that holds the ARCoS git access - Lakshya's - so a copy of the
# application started anywhere else can compare and dry-run but never push.
# Unset, every push is refused with PUSH_DISABLED.
APM_ALLOW_PUSH=

# Only for a dashboard served from another origin (npm run dev): the origins
# allowed to call the API, comma-separated. The built dashboard is served from
# the same origin and needs none. '*' is refused.
# APM_CORS_ORIGINS=http://localhost:5173

# Host directories mounted writable into the container. Defaults: ./out and
# ./workspace inside this checkout (they exist after a clone). Point the
# workspace at a disk with room - clones of the kernel and openssl take GBs.
# APM_OUT_HOST_DIR=./out
# APM_WORKSPACE_HOST_DIR=/var/tmp/arcos-package-manager
# Downloaded Debian/OSV data; a named Docker volume unless set.
# APM_CACHE_HOST_DIR=

# ---------------------------------------------------------------------------
# Repository access (git fetch / clone / push)
# ---------------------------------------------------------------------------
# local  git runs in the container with the SSH key below. Right on a server
#        whose own key can reach the private repositories.
# auto   only private repositories (APM_PRIVATE_REPOSITORY_PATTERNS) go over an
#        SSH bridge host; everything else runs locally.
# ssh    every git command runs on the bridge host.
APM_GIT_BACKEND=local

# (*) The HOST path of the SSH private key git should use (APM_GIT_BACKEND=local).
# Mounted read-only into the container; it is never copied into the image.
# It must be readable by APM_UID and must not need a passphrase (use a key
# made for this, e.g. a deploy/machine key, or one already used on this host).
# APM_GIT_SSH_KEY_FILE=/home/<user>/.ssh/id_ed25519
# Optional: your known_hosts, mounted read-only. GitHub's host keys are built
# into the image (fetched from GitHub's API over HTTPS), so github.com works
# without it.
# APM_SSH_KNOWN_HOSTS_FILE=/home/<user>/.ssh/known_hosts
APM_SSH_STRICT_HOST_KEY_CHECKING=yes

# Which repositories are private (regular expressions on the URL); used by the
# auto backend. Overrides config/settings.yaml.
# APM_PRIVATE_REPOSITORY_PATTERNS=github\.com[:/]+myorg/

# ---------------------------------------------------------------------------
# GitHub API (read-only: to find pull requests and their checks)
# ---------------------------------------------------------------------------
# This application never opens, submits or merges a pull request - a person
# opens each one from the branch's Compare Link. The SSH key above pushes
# branches; this token only lets the REST API be READ: finding a pull request a
# person opened, and its CI checks. Fine-grained token on the package
# repositories: "Pull requests: Read" + "Metadata: Read", and "Checks: Read" +
# "Commit statuses: Read". No write permission is needed or used. If the
# organisation enforces SAML SSO, authorise the token.
#
# Leave EMPTY and everything else still works: pull requests are then found
# from git refs. Enter it on the server yourself; never paste it into chat,
# logs or git. It is never written to the image and never printed.
APM_GITHUB_TOKEN=
APM_GITHUB_API_URL=https://api.github.com

# Author and committer of the commits the tool creates (debian/upstream.md,
# patch branches).
APM_COMMITTER_NAME=ARCoS Package Manager
APM_COMMITTER_EMAIL=arcos-package-manager@localhost

# ---------------------------------------------------------------------------
# Timeouts (seconds) and caching
# ---------------------------------------------------------------------------
APM_CACHE_TTL=86400
APM_HTTP_TIMEOUT=120
APM_GIT_TIMEOUT=90
# A first fetch of the kernel's history takes minutes; this bounds a stall.
APM_GIT_LONG_TIMEOUT=1800

# ---------------------------------------------------------------------------
# Optional: SSH bridge (APM_GIT_BACKEND=auto or ssh) - a different host that
# has the repository access. Not needed on a server that has it itself.
# ---------------------------------------------------------------------------
# May be an ssh_config alias. Key auth preferred; a password is a last resort
# and is a secret.
# APM_SSH_HOST=
# APM_SSH_USER=
# APM_SSH_PORT=22
# APM_SSH_IDENTITY_FILE=/home/<user>/.ssh/id_bridge   # host path, mounted read-only
# APM_SSH_PROXY_JUMP=
# APM_SSH_CONNECT_TIMEOUT=30
# APM_SSH_OPTIONS=ServerAliveInterval=30,ServerAliveCountMax=3
# APM_SSH_PASSWORD=

# ---------------------------------------------------------------------------
# Development / fallback runtime without Docker (scripts/server.sh)
# ---------------------------------------------------------------------------
# These apply only outside Docker; the compose file sets them for the container.
# APM_HOST=0.0.0.0
# APM_CACHE_DIR=~/.cache/arcos-package-manager
# APM_WORKSPACE_DIR=/var/tmp/arcos-package-manager
# APM_PACKAGES_FILE=          # default: out/packages.yaml (scripts/env.sh)
# APM_APPROVALS_FILE=         # default: out/approvals.yaml
# APM_FRONTEND_DIST=          # default: frontend/dist
VITE_API_BASE_URL=/api
